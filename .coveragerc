[run]
source = .
omit =
    tests/*
    setup/*
    *paradata.py

[report]
# Ratchet: set below the test lane's measured 69.4% (the docker-tool test job, 2026-11-02).
# Raised from 38 (2026-08-06, a fast-lane baseline of 40.62%): a floor left far below the
# real number stops being a ratchet, and coverage could fall by thirty points and still pass.
fail_under = 65
show_missing = True
