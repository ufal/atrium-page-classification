[run]
source = .
omit =
    tests/*
    setup/*
    *paradata.py

[report]
# Ratchet: set ~2 points below the measured fast-lane baseline of 40.62%
# (2026-08-06, issue atrium-project#10 Phase 6). Raised from 28 — the suites grew
# substantially in the 08-05/06 round, and a floor left far below the real number
# stops being a ratchet: coverage can fall by twenty points and still pass.
fail_under = 38
show_missing = True
