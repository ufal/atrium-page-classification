# atrium-page-classification — the published environment contract (atrium-project#60).
#
# Copy to `.env` and edit. Do not commit `.env`.
# (Add `.env` to this repo's .gitignore — it is not there yet.)
#
# This file is the COMPLETE ledger: every variable the api image's own
# configuration surface reads, with the default that is in the CODE. The curated
# partner-facing subset is the table in the hub's docs/k8s_deployment.md.
#
# This is the SHORTEST of the five, and that is the correct output rather than a
# gap. page-classification's service layer reads nothing beyond the shared set:
# service/inference.py, service/document_json.py and service/api_client.py
# contain no environment reads at all, and the batch CLI (run.py, classifier.py,
# ensemble.py, model_registry.py …) is configured entirely through argparse and
# config.txt. A short contract here means the service has few deployment knobs,
# not that some were missed.
#
# ── Read this before assuming an entry works ─────────────────────────────────
# Nothing here loads a .env file. No module imports python-dotenv, and
# docker-compose.yml has no `env_file:`. Compose reads `.env` ONLY to expand
# ${VAR} inside docker-compose.yml itself, so a variable reaches the container
# only if the `api` service's `environment:` block passes it through. Tags:
#
#   [compose + k8s]  passed through by docker-compose.yml's api service, and
#                    settable in the k8s manifest's env: block. Works both ways.
#   [k8s / -e only]  NOT passed by docker-compose today — setting it in .env
#                    does nothing. Set it in the k8s manifest's env: block, or
#                    with `docker run -e VAR=...`. atrium-project#60 step 4 adds
#                    the missing passthroughs; until then this tag is the truth.
#
# ── A variable deliberately absent ───────────────────────────────────────────
# LOG_LEVEL is read by service/api.py:361 and is NOT listed here — and THIS repo
# is the reason it is withheld across all five. service/inference.py:21 calls
# logging.basicConfig(level=logging.INFO) at module scope; service/api.py:16
# imports that module at the top of the file; and the entrypoint's own
# basicConfig at :360 has no force=True, so it is a no-op against the root
# handler already installed. LOG_LEVEL is read here and has no effect. Publishing
# it would document a bug into the partner-facing reference — the same mistake
# atrium-project#58 was raised to stop with PORT. Tracked in atrium-project#61;
# the variable is published in all five files only once that closes.

# ── Image / provenance ────────────────────────────────────────────────────────
# Read by no Python — docker-compose.yml interpolates these into the image tag
# and the build args. [compose only, by construction]
# Image tag used by docker-compose (matches para_config.txt [tool] on release)
ATRIUM_VERSION=dev
# Stamped into paradata as runner_ref
ATRIUM_RUNNER_REF=dev

# ── HTTP surface ──────────────────────────────────────────────────────────────
# [compose + k8s] Port the api service binds, and the port service/healthcheck.py
# probes inside the container. docker-compose.yml maps "${PORT:-8000}:${PORT:-8000}",
# so changing it here moves listener, published port and HEALTHCHECK together. In
# Kubernetes, change `containerPort` in the same edit. (atrium-project#58)
PORT=8000
# [k8s / -e only] Bind address. Leave at 0.0.0.0. service/healthcheck.py always
# probes 127.0.0.1 by design and never reads HOST, so 127.0.0.1 here gives a
# container that reports HEALTHY to every probe while being unreachable from
# outside it. This is the one value whose failure mode is silent.
HOST=0.0.0.0
# [compose + k8s] CSV of CORS origins. The CODE default is `*` — wide open —
# because service/atrium_service.py:370 falls back to it when unset.
# docker-compose.yml supplies its own narrower default
# (http://localhost:8080,http://127.0.0.1:8080), which applies ONLY under compose;
# note it spells loopback differently from alto-postprocess's compose default, and
# `localhost` and `127.0.0.1` are DIFFERENT origins to a browser. Kubernetes never
# reads docker-compose.yml, so a k8s deployment that does not set this runs `*`.
ALLOWED_ORIGINS=*
# [k8s / -e only] Canonical upload limit in megabytes. 10 is THIS repo's built-in
# (service/api.py:56, `resolve_max_upload_mb(10)`); the five services do not share
# one value — alto 25, llm-enrich 10, nlp-enrich 5, page-classification 10,
# translator 50. Applies to both /predict_image and /predict_document.
MAX_UPLOAD_MB=10
# DEPRECATED — do not set. A byte-valued fallback kept working for one release for
# callers that already exported it (strategy §4.5); MAX_UPLOAD_MB wins whenever
# both are present (service/atrium_service.py:353-364). Listed commented-out so
# the contract is complete and the deprecation is discoverable.
# MAX_UPLOAD_BYTES=
# [k8s / -e only] Path the container's own HEALTHCHECK probes. Change it only
# alongside the route itself.
HEALTHCHECK_PATH=/health

# ── Lifecycle ─────────────────────────────────────────────────────────────────
# [k8s / -e only] Seconds uvicorn waits for in-flight requests after SIGTERM.
# A multi-page PDF is classified synchronously inside the request, so a large
# document can legitimately outlast the default — raise this together with the
# deployment's grace period (terminationGracePeriodSeconds in k8s, see
# docs/k8s_deployment.md in the hub; stop_grace_period under compose).
GRACEFUL_SHUTDOWN_S=20
# [k8s / -e only] Filesystem auto-reload. Development only — never in a
# deployment. Deliberately NOT wired into any compose or k8s template.
RELOAD=false

LOG_LEVEL=INFO
